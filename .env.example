# ============================================================================
# Mortem Local Environment Variables (.env.local / apps/web/.env.local)
# Copy to `.env.local` and `apps/web/.env.local` for Next.js (`npm run dev`),
# and to `apps/web/.dev.vars` for Cloudflare Wrangler (`npx wrangler dev`).
# ============================================================================

# --- Runtime & Platform Smoke (THE-213) ---
ENVIRONMENT="development"
# Required header `x-mortem-admin-secret` when calling `/api/internal/platform-smoke` in staging/production
MORTEM_ADMIN_SECRET="replace-with-32-byte-hex-admin-secret"

# --- Authentication & Workspace Sessions (THE-171) ---
# Minimum 32-character high-entropy secret used by Better Auth to sign session cookies & tokens
BETTER_AUTH_SECRET="replace-with-32-byte-hex-better-auth-secret"
# Canonical base URL of the web application (`http://localhost:3000` locally, Worker URL in prod)
BETTER_AUTH_URL="http://localhost:3000"

# Optional Google OAuth credentials (leave empty locally to use email/password auth only)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Google PageSpeed Insights (THE-180) ---
# Server-side only. Used by the mortem-scan Worker (workers/scan/.dev.vars locally,
# `wrangler secret put PAGESPEED_API_KEY` in staging/production). Never expose it to the browser.
# Create it in Google Cloud Console > APIs & Services > Credentials, with the
# "PageSpeed Insights API" enabled. Without it, performance results are recorded as
# `api_key_missing` instead of being estimated.
PAGESPEED_API_KEY=""

# --- Cloudflare Turnstile & Email OTP Verification (THE-171 / THE-173) ---
# Cloudflare Turnstile keys for Sign Up, Sign In, and anonymous preview scan intake
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Resend transactional email API key & sender address for 5-minute OTP codes
RESEND_API_KEY=""
MORTEM_EMAIL_FROM="mortem@corstack.dev"
