# ============================================================================
# Mortem Local Environment Variables (.env.local / apps/web/.env.local)
# Copy to `.env.local` and `apps/web/.env.local` for Next.js (`npm run dev`),
# and to `apps/web/.dev.vars` for Cloudflare Wrangler (`npx wrangler dev`).
# ============================================================================

# --- Runtime & Platform Smoke (THE-213) ---
ENVIRONMENT="development"
# Required header `x-mortem-admin-secret` when calling `/api/internal/platform-smoke` in staging/production
MORTEM_ADMIN_SECRET="replace-with-32-byte-hex-admin-secret"

# --- Authentication & Workspace Sessions (THE-171) ---
# Minimum 32-character high-entropy secret used by Better Auth to sign session cookies & tokens
BETTER_AUTH_SECRET="replace-with-32-byte-hex-better-auth-secret"
# Canonical base URL of the web application (`http://localhost:3000` locally, Worker URL in prod)
BETTER_AUTH_URL="http://localhost:3000"

# Optional Google OAuth credentials (leave empty locally to use email/password auth only)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- URL Intake & Abuse Protection (THE-173) ---
# Cloudflare Turnstile keys for anonymous preview scan intake (leave empty locally to bypass Turnstile challenge)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
