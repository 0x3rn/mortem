    "test": "vitest run",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@cloudflare/playwright": "^1.3.6",
    "@mortem/core": "*"
  },
  "devDependencies": {
    "wrangler": "^4.150.0"
  }
