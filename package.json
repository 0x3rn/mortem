{
  "name": "mortem",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "workers/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace @mortem/web run dev",
    "build": "npm --workspaces --if-present run build",
    "start": "npm --workspace @mortem/web run start",
    "typecheck": "npm --workspaces --if-present run typecheck",
    "lint": "npm --workspaces --if-present run lint",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,json,md,yml}\"",
    "test": "npm --workspaces --if-present run test",
    "test:e2e": "npm --workspace @mortem/web run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.5.3",
    "typescript": "^5",
    "vitest": "^3.0.9"
  }
}
